+#[cfg(test)]
+mod direct_handshake_fallback_tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn connected_tcp_socket_closed_before_security_handshake_is_retryable() {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let endpoint = listener.local_addr().unwrap();
+        let (client, accepted) = tokio::join!(
+            tokio::net::TcpStream::connect(endpoint),
+            listener.accept()
+        );
+        drop(accepted.unwrap());
+        let mut stream = Stream::Tcp(hbb_common::tcp::FramedStream::from(client.unwrap(), endpoint));
+        let (public, secret) = sign::gen_keypair();
+        let id = IdPk {
+            id: "test-device".into(),
+            pk: vec![1; 32].into(),
+            ..Default::default()
+        };
+        let signed = sign::sign(&id.write_to_bytes().unwrap(), &secret);
+        let error = Client::secure_connection("test-device", signed, &crate::encode64(public.0), &mut stream)
+            .await.unwrap_err();
+        assert_eq!(error.to_string(), "Reset by the peer");
+        assert!(should_retry_secure_connection_through_relay("TCP", true, &error));
+    }
+
+    #[test]
+    fn direct_transport_failures_can_use_relay() {
+        let reset = std::io::Error::new(std::io::ErrorKind::UnexpectedEof, "Reset by the peer").into();
+        for transport in ["TCP", "UDP", "IPv6"] {
+            assert!(should_retry_secure_connection_through_relay(transport, true, &reset));
+        }
+        assert!(!should_retry_secure_connection_through_relay("TCP", false, &reset));
+        assert!(!should_retry_secure_connection_through_relay("Relay", false, &reset));
+        let invalid = anyhow!("Peer identity verification failed");
+        assert!(!should_retry_secure_connection_through_relay("TCP", true, &invalid));
+        assert!(should_retry_secure_connection_through_relay("WebRTC", true, &invalid));
+    }
+}
