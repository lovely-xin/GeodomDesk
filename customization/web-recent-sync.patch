+test("a single removal supersedes a newer active record from another client", async () => {
+  const { connect } = fixture();
+  const browser = connect("delete-newer");
+  const device = { id, alias: "Device", platform: "Windows" };
+  browser.rows.set(id, { ...device, hash: key, geodom_recent: profile(Date.now() - 100, {}) });
+  await browser.sync.run();
+
+  browser.devices.remove(id);
+  browser.sync.change(device, { removed: true }, { credential: "clear" });
+  const competingRevision = Date.now() + 1_000;
+  browser.rows.set(id, { ...device, hash: key, geodom_recent: profile(competingRevision, {}) });
+  await browser.sync.run();
+
+  const saved = browser.rows.get(id);
+  assert.equal(JSON.parse(saved.geodom_recent).removed, true);
+  assert.ok(JSON.parse(saved.geodom_recent).timestamp > competingRevision);
+  assert.equal(saved.hash, "");
+  assert.equal(browser.devices.values.length, 0);
+});
+
+test("a removal stays pending if a concurrent update wins before the server receives it", async () => {
+  const { connect } = fixture();
+  const browser = connect("delete-race");
+  const device = { id, alias: "Device", platform: "Windows" };
+  browser.rows.set(id, { ...device, geodom_recent: profile(Date.now() - 100, {}) });
+  await browser.sync.run();
+  const request = browser.api.request;
+  let conflict = true;
+  browser.api.request = async (path, method, data) => {
+    if (conflict && method === "PUT") {
+      conflict = false;
+      const timestamp = JSON.parse(data.geodom_recent).timestamp + 1;
+      browser.rows.set(id, { ...device, geodom_recent: profile(timestamp, {}) });
+    }
+    return request(path, method, data);
+  };
+
+  browser.devices.remove(id);
+  browser.sync.change(device, { removed: true });
+  await assert.rejects(browser.sync.run({ force: true }), /部分设备/);
+  assert.equal(browser.devices.values.length, 0);
+  await browser.sync.run({ force: true });
+  assert.equal(JSON.parse(browser.rows.get(id).geodom_recent).removed, true);
+  assert.equal(browser.devices.values.length, 0);
+});
+
+test("a change queued during a write is sent after the active sync completes", async () => {
+  const { connect } = fixture();
+  const browser = connect("queued-during-write");
+  await browser.sync.run();
+  const second = "987654321";
+  const request = browser.api.request;
+  let reached;
+  let release;
+  const pendingWrite = new Promise((resolve) => { reached = resolve; });
+  const writeGate = new Promise((resolve) => { release = resolve; });
+  browser.api.request = async (path, method, data) => {
+    if (data?.id === id) {
+      reached();
+      await writeGate;
+    }
+    return request(path, method, data);
+  };
+  browser.sync.change({ id, alias: "First", platform: "Windows" });
+  const firstRun = browser.sync.run();
+  await pendingWrite;
+  browser.sync.change({ id: second, alias: "Second", platform: "Linux" });
+  const secondRun = browser.sync.run();
+  release();
+  await Promise.all([firstRun, secondRun]);
+  assert.equal(browser.rows.get(second).alias, "Second");
+  assert.deepEqual(browser.rows.get(second).tags, ["GeodomDesk 最近访问"]);
+});
+
+test("forgetting a credential preserves newer device details and tags", async () => {
+  const { connect } = fixture();
+  const browser = connect("forget-newer");
+  const before = { id, alias: "Before", platform: "Windows", tags: ["Existing"] };
+  browser.rows.set(id, { ...before, hash: key, geodom_recent: profile(Date.now() - 100, {}) });
+  await browser.sync.run();
+  browser.sync.change(before, {}, { credential: "clear" });
+  browser.rows.set(id, { ...before, alias: "Renamed elsewhere", hash: key,
+    geodom_recent: profile(Date.now() + 1000, { force_relay: true }) });
+  await browser.sync.run();
+  const after = browser.rows.get(id);
+  assert.equal(after.hash, "");
+  assert.equal(after.alias, "Renamed elsewhere");
+  assert.deepEqual(after.tags, ["Existing"]);
+  assert.equal(JSON.parse(after.geodom_recent).force_relay, true);
+});
+
+test("a full tag list still allows a new recent visit", async () => {
+  const { connect } = fixture();
+  const browser = connect("full-tags");
+  await browser.sync.run();
+  const request = browser.api.request;
+  let rejected = 0;
+  browser.api.request = async (path, method, data) => {
+    if (data?.tags) {
+      rejected++;
+      throw Object.assign(new Error("Too many tags"), { status: 409 });
+    }
+    return request(path, method, data);
+  };
+  browser.sync.change({ id, alias: "Recent", platform: "Windows" });
+  await browser.sync.run();
+  assert.equal(rejected, 1);
+  assert.equal(browser.rows.get(id).alias, "Recent");
+});
