$ErrorActionPreference='Stop'
$Config='@@CONFIG@@'
$ExpectedHost='@@HOST@@'
$ExpectedRelay='@@RELAY@@'
$ExpectedApi='@@API@@'
$ExpectedWsPort='@@WS_PORT@@'
$ExpectedKey='@@KEY@@'
$ExpectedVersion=[Version]'@@VERSION@@'
$PermanentPassword='@@PASSWORD_PS@@'
$Payload=Join-Path $PSScriptRoot 'geodomdesk-client.exe'
$PayloadHash='@@DIGEST@@'
if ((Get-FileHash -LiteralPath $Payload -Algorithm SHA256).Hash.ToLowerInvariant() -ne $PayloadHash) {throw 'GeodomDesk package checksum mismatch'}
function Find-Installed {
  foreach($root in @($env:ProgramW6432,$env:ProgramFiles,${env:ProgramFiles(x86)})) {
    if($root) {$candidate=Join-Path $root 'GeodomDesk\GeodomDesk.exe'; if(Test-Path -LiteralPath $candidate){return $candidate}}
  }
}
function Client-Version([string]$Path) {
  if($Path){$text=[Diagnostics.FileVersionInfo]::GetVersionInfo($Path).ProductVersion;if($text -match '(\d+\.\d+\.\d+)'){return [Version]$Matches[1]}}
  return [Version]'0.0.0'
}
$Existing=Find-Installed
$PreserveExistingPassword=[bool]$Existing
if(Test-Path -LiteralPath (Join-Path $env:APPDATA 'GeodomDesk\config\GeodomDesk.toml')){$PreserveExistingPassword=$true}
if((Client-Version $Existing) -le $ExpectedVersion) {
  $p=Start-Process -FilePath $Payload -ArgumentList '--silent-install' -WindowStyle Hidden -PassThru
  if (-not $p.WaitForExit(120000)) {throw 'GeodomDesk installation timed out'}
}
$Installed=$null
for($i=0;$i -lt 60;$i++) {
  $Installed=Find-Installed
  $service=Get-Service -Name 'GeodomDesk' -ErrorAction SilentlyContinue
  if($Installed -and $service -and (Client-Version $Installed) -ge $ExpectedVersion){break}
  Start-Sleep -Seconds 2
}
if(-not $Installed -or -not $service -or (Client-Version $Installed) -lt $ExpectedVersion){throw 'The expected GeodomDesk version and service were not found'}
if($service.Status -ne 'Running'){Start-Service -Name 'GeodomDesk'}
function Quote-ClientArgument([string]$Value) {
  $escaped=[regex]::Replace($Value,'(\\*)"','$1$1\"')
  $escaped=[regex]::Replace($escaped,'(\\+)$','$1$1')
  return '"'+$escaped+'"'
}
function Invoke-GeodomDesk([string[]]$ClientArgs) {
  $start=New-Object Diagnostics.ProcessStartInfo
  $start.FileName=$Installed
  $start.Arguments=($ClientArgs | ForEach-Object {Quote-ClientArgument $_}) -join ' '
  $start.UseShellExecute=$false
  $start.CreateNoWindow=$true
  $start.RedirectStandardOutput=$true
  $start.RedirectStandardError=$true
  $start.StandardOutputEncoding=New-Object Text.UTF8Encoding($false)
  $start.StandardErrorEncoding=New-Object Text.UTF8Encoding($false)
  $process=New-Object Diagnostics.Process
  $process.StartInfo=$start
  try {
    if(-not $process.Start()){throw 'GeodomDesk configuration command could not start'}
    $output=$process.StandardOutput.ReadToEndAsync()
    $errors=$process.StandardError.ReadToEndAsync()
    if(-not $process.WaitForExit(15000)) {
      $process.Kill()
      $null=$process.WaitForExit(3000)
      throw 'GeodomDesk configuration command timed out'
    }
    if(-not [Threading.Tasks.Task]::WaitAll([Threading.Tasks.Task[]]@($output,$errors),3000)){throw 'GeodomDesk configuration output timed out'}
    $text=$output.GetAwaiter().GetResult().Trim()
    $null=$errors.GetAwaiter().GetResult()
    if($process.ExitCode -ne 0){throw ('GeodomDesk '+$ClientArgs[0]+' failed (exit code '+$process.ExitCode+').')}
    return $text
  } finally {$process.Dispose()}
}
$verified=$false
for($i=0;$i -lt 8;$i++) {
  $null=Invoke-GeodomDesk @('--config',$Config)
  if($ExpectedWsPort){$null=Invoke-GeodomDesk @('--option','websocket-port',$ExpectedWsPort)}
  $hostValue=Invoke-GeodomDesk @('--option','custom-rendezvous-server')
  $keyValue=Invoke-GeodomDesk @('--option','key')
  $apiValue=Invoke-GeodomDesk @('--option','api-server')
  $relayValue=Invoke-GeodomDesk @('--option','relay-server')
  $wsPortValue=if($ExpectedWsPort){Invoke-GeodomDesk @('--option','websocket-port')}else{''}
  if($hostValue -eq $ExpectedHost -and $keyValue -eq $ExpectedKey -and $apiValue -ceq $ExpectedApi -and $relayValue -ceq $ExpectedRelay -and $wsPortValue -ceq $ExpectedWsPort){$verified=$true;break}
  Start-Sleep -Seconds 2
}
if(-not $verified){throw 'GeodomDesk was installed, but the Geodom server settings could not be verified. Run this installer again after signing into Windows.'}
$null=Invoke-GeodomDesk @('--option','allow-auto-update','Y')
if((Invoke-GeodomDesk @('--option','allow-auto-update')) -cne 'Y'){throw 'GeodomDesk update setting could not be verified'}
if($PermanentPassword) {
  if($PreserveExistingPassword) {
    Write-Output 'Existing GeodomDesk password and verification mode preserved.'
  } else {
  $passwordVerified=$false
  for($i=0;$i -lt 8;$i++) {
    $passwordResult=Invoke-GeodomDesk @('--password',$PermanentPassword)
    if($passwordResult -ceq 'Done!') {
      $null=Invoke-GeodomDesk @('--option','verification-method','use-permanent-password')
      $method=Invoke-GeodomDesk @('--option','verification-method')
      if($method -ceq 'use-permanent-password'){$passwordVerified=$true;break}
    }
    Start-Sleep -Seconds 2
  }
  if(-not $passwordVerified){throw 'GeodomDesk permanent password could not be set and verified.'}
  Write-Output 'Permanent access password set; password verification mode confirmed.'
  }
}
Write-Output 'GeodomDesk installation and Geodom server configuration verified.'
exit 0
