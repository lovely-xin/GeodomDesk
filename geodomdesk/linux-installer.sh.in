#!/bin/sh
# GeodomDesk installer. The custom GeodomDesk package follows this script.
set -eu
VERSION='@@VERSION@@'
ARCH='@@ARCH@@'
KIND='@@KIND@@'
PAYLOAD_OFFSET=0000000000
PAYLOAD_SHA256='@@DIGEST@@'
SERVER='@@HOST@@'
RELAY='@@RELAY@@'
API='@@API@@'
WS_PORT='@@WS_PORT@@'
SERVER_KEY='@@KEY@@'
CONFIG='@@CONFIG@@'
PERMANENT_PASSWORD=@@PASSWORD_SH@@

case "${1:-}" in
  --help|-h)
    printf 'GeodomDesk %s (%s, %s)\nRun: sudo sh %s\nVerify without installing: sh %s --check\nSource and license: https://www.qcjcpt.com/downloads/geodomdesk/\n' "$VERSION" "$KIND" "$ARCH" "$0" "$0"
    exit 0;;
esac
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
tail -c +"$((PAYLOAD_OFFSET + 1))" "$0" > "$tmp/geodomdesk.$KIND"
printf '%s  %s\n' "$PAYLOAD_SHA256" "$tmp/geodomdesk.$KIND" | sha256sum -c - >/dev/null
if [ "${1:-}" = --check ]; then
  printf 'Verified GeodomDesk %s package (%s/%s). Server: %s\n' "$VERSION" "$KIND" "$ARCH" "$SERVER"
  exit 0
fi
if [ "$(id -u)" != 0 ]; then
  printf 'Please run this installer with sudo: sudo sh %s\n' "$0" >&2
  exit 1
fi
printf 'Installing GeodomDesk %s for server %s\n' "$VERSION" "$SERVER"
PRESERVE_PASSWORD=0
if [ -x /usr/bin/geodomdesk ] || [ -f /root/.config/geodomdesk/GeodomDesk.toml ]; then PRESERVE_PASSWORD=1; fi
if [ -n "${SUDO_USER:-}" ]; then
  user_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
  if [ -n "$user_home" ] && [ -f "$user_home/.config/geodomdesk/GeodomDesk.toml" ]; then PRESERVE_PASSWORD=1; fi
fi
printf 'GeodomDesk is distributed under AGPL-3.0. Source: https://www.qcjcpt.com/downloads/geodomdesk/releases/%s/\n' "$VERSION"
if [ "$KIND" = deb ]; then
  command -v apt-get >/dev/null || { echo 'This installer requires Ubuntu/Debian. Choose the RPM installer for Fedora/RHEL.' >&2; exit 1; }
  [ "$(dpkg --print-architecture)" = "$ARCH" ] || { echo 'Wrong CPU architecture.' >&2; exit 1; }
  package_version=$(dpkg-deb -f "$tmp/geodomdesk.deb" Version)
  installed_version=$(dpkg-query -W -f='${Version}' geodomdesk 2>/dev/null || true)
  if [ -x /usr/bin/geodomdesk ] && [ -n "$installed_version" ] && dpkg --compare-versions "$installed_version" ge "$package_version"; then
    printf 'Keeping installed GeodomDesk %s.\n' "$installed_version"
  else
    apt-get install -y "$tmp/geodomdesk.deb"
  fi
else
  [ "$(uname -m)" = "$ARCH" ] || { echo 'Wrong CPU architecture.' >&2; exit 1; }
  if command -v dnf >/dev/null; then dnf install -y "$tmp/geodomdesk.rpm"
  elif command -v yum >/dev/null; then yum localinstall -y "$tmp/geodomdesk.rpm"
  else echo 'This installer requires Fedora/RHEL-compatible dnf or yum.' >&2; exit 1; fi
fi
command -v systemctl >/dev/null || { echo 'systemd is required to start GeodomDesk.' >&2; exit 1; }
systemctl enable --now geodomdesk.service
set_websocket_port() {
  if [ -z "$WS_PORT" ]; then return 0; fi
  timeout 10 /usr/bin/geodomdesk --option websocket-port "$WS_PORT" >/dev/null 2>&1 &&
  actual_ws_port=$(timeout 10 /usr/bin/geodomdesk --option websocket-port 2>/dev/null) &&
  [ "$actual_ws_port" = "$WS_PORT" ]
}
ok=0
for attempt in 1 2 3 4 5 6 7 8; do
  if timeout 15 /usr/bin/geodomdesk --config "$CONFIG" >/dev/null 2>&1 &&
     set_websocket_port &&
     host=$(timeout 10 /usr/bin/geodomdesk --option custom-rendezvous-server 2>/dev/null) &&
     key=$(timeout 10 /usr/bin/geodomdesk --option key 2>/dev/null) &&
     api=$(timeout 10 /usr/bin/geodomdesk --option api-server 2>/dev/null) &&
     relay=$(timeout 10 /usr/bin/geodomdesk --option relay-server 2>/dev/null) &&
     [ "$host" = "$SERVER" ] && [ "$key" = "$SERVER_KEY" ] && [ "$api" = "$API" ] && [ "$relay" = "$RELAY" ]; then ok=1; break; fi
  sleep 2
done
if [ "$ok" != 1 ]; then
  echo 'GeodomDesk was installed, but server configuration could not be verified. Log into the desktop and run this installer again.' >&2
  exit 2
fi
if [ -n "$PERMANENT_PASSWORD" ]; then
  if [ "$PRESERVE_PASSWORD" = 1 ]; then
    printf 'Existing GeodomDesk password and verification mode preserved.\n'
  else
  password_ok=0
  for attempt in 1 2 3 4 5 6 7 8; do
    if password_result=$(timeout 15 /usr/bin/geodomdesk --password "$PERMANENT_PASSWORD" 2>/dev/null) &&
       [ "$password_result" = 'Done!' ] &&
       timeout 15 /usr/bin/geodomdesk --option verification-method use-permanent-password >/dev/null 2>&1 &&
       method=$(timeout 10 /usr/bin/geodomdesk --option verification-method 2>/dev/null) &&
       [ "$method" = 'use-permanent-password' ]; then password_ok=1; break; fi
    sleep 2
  done
  if [ "$password_ok" != 1 ]; then
    echo 'GeodomDesk permanent password could not be set and verified.' >&2
    exit 3
  fi
  printf 'Permanent access password set; password verification mode confirmed.\n'
  fi
fi
printf 'Installation and server configuration verified. Open GeodomDesk from your application launcher.\n'
exit 0
# The official binary package is appended below. Do not edit this file.
