  Widget importOfficialUserData() {
    return _Card(title: 'Data migration', children: [
      Align(
        alignment: Alignment.centerLeft,
        child: Text(
          _translateImportText('Import matching-server device records from %upstream%.'),
          style: Theme.of(context).textTheme.bodySmall,
        ),
      ).marginOnly(left: _kContentHMargin, right: _kContentHMargin, bottom: 10),
      _Button('Import', _importOfficialUserData, enabled: !_importingUserData),
      if (_importUserDataStatus.isNotEmpty)
        Align(
          alignment: Alignment.centerLeft,
          child: Text(_importUserDataStatus),
        ).marginOnly(left: _kContentHMargin),
    ]);
  }

  String _translateImportText(String key) =>
      translate(key).replaceAll('%upstream%', 'RustDesk');

  Future<void> _importOfficialUserData() async {
    if (_importingUserData) return;
    setState(() { _importingUserData = true; _importUserDataStatus = ''; });
    try {
      final confirmed = await gFFI.dialogManager.show<bool>((setState, close, context) {
        return CustomAlertDialog(
          title: Text(_translateImportText('Import %upstream%')),
          content: Text(translate('Only device records with the same ID-server public key will be imported. Existing records, settings and passwords are preserved.')),
          actions: [
            dialogButton('Cancel', onPressed: () => close(false), isOutline: true),
            dialogButton('Import', onPressed: () => close(true)),
          ],
          onCancel: () => close(false),
        );
      });
      if (confirmed != true || !mounted) return;
      final result = jsonDecode(await bind.mainImportOfficialUserData());
      await bind.mainLoadRecentPeers();
      await bind.mainLoadFavPeers();
      if (!mounted) return;
      setState(() {
        _importUserDataStatus = '${translate('Import complete')}: '
            '${translate('Added')} ${result['added']}, '
            '${translate('Existing')} ${result['existing']}, '
            '${translate('Skipped')} ${result['skipped']}, '
            '${translate('Favorites')} +${result['favorites_added']}';
      });
    } catch (_) {
      if (mounted) {
        setState(() {
          _importUserDataStatus = _translateImportText('Unable to import %upstream% device records. Check that %upstream% user data exists for this user.');
        });
      }
    } finally {
      if (mounted) {
        setState(() => _importingUserData = false);
      }
    }
  }

